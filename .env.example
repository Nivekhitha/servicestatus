# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# Twilio SMS & WhatsApp Integration (Optional - Required for live SMS/WhatsApp delivery)
# Configure in Settings > Secrets or your deployment environment.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=

# Firebase Cloud Messaging (Optional - Web Push VAPID key for push notifications)
VITE_FIREBASE_VAPID_KEY=
